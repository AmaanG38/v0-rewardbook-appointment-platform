# ===========================================
# DOCKER IGNORE FILE
# Excludes files from Docker build context
# Improves build speed and reduces image size
# ===========================================

# Dependencies - will be installed fresh in container
node_modules
npm-debug.log
yarn-debug.log
yarn-error.log

# Next.js build output - will be rebuilt in container
.next
out

# Environment files - should be passed via docker-compose or runtime
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE and editor files
.vscode
.idea
*.swp
*.swo

# Git files
.git
.gitignore

# Docker files (no need to copy these into the image)
Dockerfile*
docker-compose*
.dockerignore

# Documentation
README.md
*.md

# Testing
coverage
.nyc_output

# Misc
.DS_Store
*.log
